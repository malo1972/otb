# Exclude the virtual environment folder
.venv/
venv/

# Exclude all binary files
*.bin

# Exclude PGN game collections (import material)
*.pgn

# Exclude Python bytecode caches
__pycache__/
*.pyc

# Installer build output (PyInstaller / Inno Setup)
build/
dist/
packaging/Output/

# Stockfish, downloaded by the installer build (never commit the binary)
engines/

# snapcraft build output
parts/
stage/
prime/
*.snap

# flatpak-builder output
.flatpak-builder/
build-dir/
repo/
